generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id        String   @id @default(cuid())
  nome      String
  cnpj      String?
  chavePix  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios   User[]
  clientes   Cliente[]
  cobrancas  Cobranca[]
  configWpp  ConfigWhatsApp?
  convites   Convite[]
  assinatura Assinatura?
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  telefone  String?
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientesCriados  Cliente[]  @relation("CriadoPor")
  cobrancasCriadas Cobranca[] @relation("CriadoPor")
  convitesEnviados Convite[]

  @@index([empresaId])
}

model Cliente {
  id          String     @id @default(cuid())
  nome        String
  telefone    String
  email       String?
  cpf         String?
  endereco    String?
  observ      String?
  ativo       Boolean    @default(true)
  empresaId   String
  empresa     Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  criadoPorId String?
  criadoPor   User?      @relation("CriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  cobrancas   Cobranca[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([empresaId])
}

model Cobranca {
  id          String       @id @default(cuid())
  descricao   String
  valor       Decimal      @db.Decimal(10, 2)
  vencimento  DateTime
  status      Status       @default(PENDENTE)
  clienteId   String
  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  empresaId   String
  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  criadoPorId String?
  criadoPor   User?        @relation("CriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  lembretes   Lembrete[]
  pagoEm      DateTime?
  observ      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([empresaId])
  @@index([clienteId])
  @@index([vencimento])
  @@index([status])
}

model Lembrete {
  id         String       @id @default(cuid())
  cobrancaId String
  cobranca   Cobranca     @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)
  tipo       TipoLembrete
  enviadoEm  DateTime     @default(now())
  sucesso    Boolean
  erro       String?

  @@index([cobrancaId])
}

model ConfigWhatsApp {
  id            String  @id @default(cuid())
  empresaId     String  @unique
  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ativo         Boolean @default(true)
  msgAntes3dias String  @default("Olá {nome}! 👋 Lembrando que sua cobrança de *R$ {valor}* referente a *{descricao}* vence em *3 dias* ({vencimento}). Qualquer dúvida, estamos à disposição!")
  msgNoDia      String  @default("Olá {nome}! 📅 Hoje é o vencimento da sua cobrança de *R$ {valor}* referente a *{descricao}*. Pague hoje para evitar atrasos! Chave PIX: *{pix}*")
  msgApos1dia   String  @default("Olá {nome}! ⚠️ Sua cobrança de *R$ {valor}* referente a *{descricao}* está em atraso desde ontem ({vencimento}). Por favor, regularize o quanto antes. Chave PIX: *{pix}*")
}

model Convite {
  id             String    @id @default(cuid())
  email          String
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  role           Role      @default(MEMBER)
  token          String    @unique @default(cuid())
  convidadoPorId String
  convidadoPor   User      @relation(fields: [convidadoPorId], references: [id], onDelete: Cascade)
  expiraEm       DateTime
  aceitoEm       DateTime?
  createdAt      DateTime  @default(now())

  @@index([empresaId])
  @@index([email])
}

model Plano {
  id              String   @id @default(cuid())
  nome            String   @unique
  slug            String   @unique
  precoMensal     Decimal  @db.Decimal(10, 2)
  maxClientes     Int
  maxCobrancasMes Int
  maxUsuarios     Int      @default(1)
  whatsappAtivo   Boolean  @default(true)
  ativo           Boolean  @default(true)
  ordem           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assinaturas Assinatura[]
}

model Assinatura {
  id                  String           @id @default(cuid())
  empresaId           String           @unique
  empresa             Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  planoId             String
  plano               Plano            @relation(fields: [planoId], references: [id])
  status              StatusAssinatura @default(TRIAL)
  asaasCustomerId     String?
  asaasSubscriptionId String?          @unique
  trialFim            DateTime?
  proximaCobranca     DateTime?
  canceladaEm         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([asaasCustomerId])
}

model AsaasEvento {
  id           String   @id @default(cuid())
  eventId      String   @unique
  tipo         String
  payload      Json
  processadoEm DateTime @default(now())
}

enum StatusAssinatura {
  TRIAL
  ATIVA
  INADIMPLENTE
  CANCELADA
  EXPIRADA
}

enum Role {
  OWNER
  MEMBER
}

enum Status {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

enum TipoLembrete {
  ANTES_3_DIAS
  NO_DIA
  APOS_1_DIA
}
